/* HALAMAN 4 */
function page4(){
app.innerHTML=`
<div class="card">
<h1>Happy Valentine 💖</h1>
<p>Makasih ya udah jadi alasan aku senyum setiap hari.
Aku selalu ada buat kamu.
Semoga kita selalu bareng selamanya 🥺💕</p>
<button class="yes" onclick="page1()">Restart</button>
</div>`;
}

page1();
</script>

</body>
</html>
