<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>For My Love 💖</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Dancing+Script:wght@600&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{
    height:100vh;
    background:linear-gradient(135deg,#ffd6e0,#ffc2d1,#ff8fab);
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
}
.card{
    width:350px;
    background:rgba(255,255,255,0.8);
    backdrop-filter:blur(15px);
    border-radius:20px;
    padding:30px;
    text-align:center;
    box-shadow:0 10px 40px rgba(0,0,0,0.1);
    animation:fade 0.6s ease;
}
h1{
    font-family:'Dancing Script',cursive;
    color:#c9184a;
    margin-bottom:15px;
}
p{font-size:14px;color:#555;margin-bottom:15px;}
button{
    padding:10px 25px;
    border:none;
    border-radius:25px;
    margin:8px;
    cursor:pointer;
    font-weight:500;
    transition:0.3s;
}
.yes{background:#ff4d6d;color:white;}
.no{background:#eee;color:#c9184a;}
.yes:hover{transform:scale(1.1);}
.no:hover{transform:scale(1.1);}
img.gallery{
    width:120px;
    height:120px;
    object-fit:cover;
    border-radius:15px;
    margin:5px;
}
.heart{
    position:fixed;
    bottom:-10px;
    font-size:20px;
    animation:float 6s linear infinite;
}
@keyframes float{
    0%{transform:translateY(0);opacity:1;}
    100%{transform:translateY(-100vh);opacity:0;}
}
@keyframes fade{
    from{opacity:0;transform:scale(0.9);}
    to{opacity:1;transform:scale(1);}
}
</style>
</head>
<body>

<div id="app"></div>

<audio autoplay loop>
<source src="abt.mp3" type="audio/mpeg">
</audio>

<script>
document.addEventListener("click", function(){
  const music = document.getElementById("bgm");
  music.play();
}, { once: true });
</script>

<script>
const app=document.getElementById("app");

function hearts(){
    const h=document.createElement("div");
    h.className="heart";
    h.innerHTML="💖";
    h.style.left=Math.random()*100+"vw";
    document.body.appendChild(h);
    setTimeout(()=>h.remove(),6000);
}
setInterval(hearts,400);

/* HALAMAN 1 */
function page1(){
app.innerHTML=`
<div class="card">
<h1>Will you be my Valentine?</h1>
<p>Please say yes 🥺</p>
<button class="yes" onclick="page2()">YES</button>
<button class="no" id="noBtn" onclick="noDrama()">NO</button>
<p id="drama"></p>
</div>`;
}

function noDrama(){
document.getElementById("drama").innerHTML=
"eits gak bisa bleeee, gw apus tombol NO nya awikwok";
document.getElementById("noBtn").style.display="none";
}

/* HALAMAN 2 */
function page2(){
app.innerHTML=`
<div class="card">
