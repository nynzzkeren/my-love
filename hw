<div>
<img src="https://cdn.discordapp.com/attachments/1468557593411715126/1472462218628038666/Config_by_AndroGcam_24_Jan_14_14.lmc_8.4.jpg?ex=6992a8cd&is=6991574d&hm=a1e1a8ff97424652c0c333649da4696d271db7a71e8cfbb9c13c04e138a30730&" class="gallery">
<img src="https://cdn.discordapp.com/attachments/1468557593411715126/1472462217688383549/Snapchat-14507511.jpg?ex=6992a8cd&is=6991574d&hm=18baf790ec2bcf69d44dda779613899359270ffc39a24cb5ac19067be8ed6f91&" class="gallery"><br>
<img src="https://cdn.discordapp.com/attachments/1468557593411715126/1472462217373941813/Screenshot_20260212_191703_Instagram.jpg?ex=6992a8cd&is=6991574d&hm=8c51099a7deab816bd9bd87233cf832a63af1ed74eb4ec4101549c366866da77&" class="gallery">
<img src="https://cdn.discordapp.com/attachments/1468557593411715126/1472462218120663181/Config_by_AndroGcam_28_Jan_06_25.lmc_8.4_2.jpg?ex=6992a8cd&is=6991574d&hm=6127b76933552e60773919a20a1a1c82893a89cc598536e6555c4ce1f252728f&" class="gallery">
</div>
<button class="yes" onclick="page3()">Satu halaman lagi...</button>
</div>`;
}

/* HALAMAN 3 */
function page3(){
app.innerHTML=`
<div class="card">
<h1>Ini kado spesial buat kamu 🎁</h1>
<img src="https://cdn.discordapp.com/attachments/1468557593411715126/1472463900518907996/OBVBUN1422_Classic-Midnight-Hand-Bouquet---Fiery-Red-large_350x.jpg?ex=6992aa5e&is=699158de&hm=aa6822247ba52c226b52ff9c90daffe499a889e6887fcac9bc2fe77db40d8bb7&" style="width:200px;border-radius:15px;margin:15px 0;">
<button class="yes" onclick="page4()">Terima hadiahnya</button>
</div>`;
